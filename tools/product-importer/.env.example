# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — your keys never get committed or sent to chat.

# Your store URL (no trailing slash)
WC_STORE_URL=https://theartframer.us

# WooCommerce REST API keys.
# Generate at: WooCommerce > Settings > Advanced > REST API > Add key
# For the analysis step, "Read" permission is enough.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WordPress Application Password — ONLY needed to upload local image files or to
# use --gallery (auto-composited mockups), which upload generated images.
# Create at: WP Admin > Users > Profile > Application Passwords.
WP_APP_USER=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
