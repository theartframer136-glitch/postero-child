# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Dependencies / build
node_modules/
vendor/

# Left behind by running the QA scripts in a clone rather than a scratch folder
# (npm i playwright). The theme has no Node build of its own, so a package.json
# appearing at the root is always this and never something to keep.
package.json
package-lock.json
kid-mode-final.png
veteran-final.png

# Local env & secrets — never commit
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519

# Logs
*.log
debug.log

# Plugin code moved into the theme keeps the plugin's own folder layout, and
# some plugins ship a folder named vendor/ (Composer autoloader, bundled JS
# libraries). Those belong to the theme copy and must be committed.
!inc/ports/**/vendor/
!assets/ports/**/vendor/

# Working copies made by Claude Code agents (never part of the theme)
.claude/
